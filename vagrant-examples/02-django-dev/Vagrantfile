# -*- mode: ruby -*-
# vi: set ft=ruby :

Vagrant.configure("2") do |config|
  config.vm.box = "ubuntu/focal64"
  config.vm.hostname = "django-dev"

  # 네트워크 설정
  config.vm.network "forwarded_port", guest: 8000, host: 8000, host_ip: "127.0.0.1"
  config.vm.network "forwarded_port", guest: 5432, host: 5432, host_ip: "127.0.0.1"
  config.vm.network "private_network", ip: "192.168.50.20"

  # VirtualBox 설정
  config.vm.provider "virtualbox" do |vb|
    vb.name = "django-dev"
    vb.memory = "2048"
    vb.cpus = 2
    vb.linked_clone = true
  end

  # Python 및 Django 환경 설치
  config.vm.provision "shell", inline: <<-SHELL
    echo "=========================================="
    echo "Django 개발 환경 설치 시작"
    echo "=========================================="

    # 시스템 업데이트
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get upgrade -y

    # Python 3 및 개발 도구
    echo "Python 3 설치 중..."
    apt-get install -y python3 python3-pip python3-venv python3-dev
    apt-get install -y build-essential libssl-dev libffi-dev
    apt-get install -y git curl

    # PostgreSQL 설치
    echo "PostgreSQL 설치 중..."
    apt-get install -y postgresql postgresql-contrib libpq-dev

    # PostgreSQL 설정
    sudo -u postgres psql -c "CREATE DATABASE djangodb;"
    sudo -u postgres psql -c "CREATE USER djangouser WITH PASSWORD 'django123';"
    sudo -u postgres psql -c "ALTER ROLE djangouser SET client_encoding TO 'utf8';"
    sudo -u postgres psql -c "ALTER ROLE djangouser SET default_transaction_isolation TO 'read committed';"
    sudo -u postgres psql -c "ALTER ROLE djangouser SET timezone TO 'UTC';"
    sudo -u postgres psql -c "GRANT ALL PRIVILEGES ON DATABASE djangodb TO djangouser;"

    # PostgreSQL 외부 접속 허용
    echo "host    all             all             0.0.0.0/0               md5" >> /etc/postgresql/12/main/pg_hba.conf
    sed -i "s/#listen_addresses = 'localhost'/listen_addresses = '*'/g" /etc/postgresql/12/main/postgresql.conf
    systemctl restart postgresql

    # Python 가상 환경 생성
    echo "Python 가상 환경 설정 중..."
    cd /vagrant
    sudo -u vagrant python3 -m venv venv

    # 가상 환경에 Django 및 의존성 설치
    sudo -u vagrant /vagrant/venv/bin/pip install --upgrade pip

    if [ -f /vagrant/requirements.txt ]; then
      echo "requirements.txt 발견! 의존성 설치 중..."
      sudo -u vagrant /vagrant/venv/bin/pip install -r /vagrant/requirements.txt
    else
      echo "기본 패키지 설치 중..."
      sudo -u vagrant /vagrant/venv/bin/pip install django psycopg2-binary djangorestframework django-debug-toolbar
    fi

    # .bashrc에 가상 환경 자동 활성화 추가
    echo 'cd /vagrant' >> /home/vagrant/.bashrc
    echo 'source venv/bin/activate' >> /home/vagrant/.bashrc

    echo "=========================================="
    echo "설치 완료!"
    echo "Python 버전: $(python3 --version)"
    echo "Django 버전: $(/vagrant/venv/bin/django-admin --version)"
    echo "PostgreSQL 버전: $(psql --version)"
    echo "=========================================="
    echo ""
    echo "데이터베이스 정보:"
    echo "  Database: djangodb"
    echo "  User: djangouser"
    echo "  Password: django123"
    echo "  Host: localhost"
    echo "  Port: 5432"
    echo "=========================================="
    echo ""
    echo "사용법:"
    echo "  vagrant ssh"
    echo "  # 가상 환경이 자동으로 활성화됩니다"
    echo "  python manage.py runserver 0.0.0.0:8000"
    echo "=========================================="
  SHELL
end
