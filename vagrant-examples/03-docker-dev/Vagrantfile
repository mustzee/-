# -*- mode: ruby -*-
# vi: set ft=ruby :

Vagrant.configure("2") do |config|
  config.vm.box = "ubuntu/focal64"
  config.vm.hostname = "docker-dev"

  # 네트워크 설정
  config.vm.network "forwarded_port", guest: 80, host: 8080, host_ip: "127.0.0.1"
  config.vm.network "forwarded_port", guest: 5000, host: 5000, host_ip: "127.0.0.1"
  config.vm.network "private_network", ip: "192.168.50.30"

  # VirtualBox 설정
  config.vm.provider "virtualbox" do |vb|
    vb.name = "docker-dev"
    vb.memory = "4096"
    vb.cpus = 2
    vb.linked_clone = true
  end

  # Docker 설치
  config.vm.provision "docker"

  # Docker Compose 및 추가 도구 설치
  config.vm.provision "shell", inline: <<-SHELL
    echo "=========================================="
    echo "Docker 개발 환경 설정 시작"
    echo "=========================================="

    # Docker Compose 설치
    echo "Docker Compose 설치 중..."
    DOCKER_COMPOSE_VERSION="2.24.0"
    curl -L "https://github.com/docker/compose/releases/download/v${DOCKER_COMPOSE_VERSION}/docker-compose-$(uname -s)-$(uname -m)" -o /usr/local/bin/docker-compose
    chmod +x /usr/local/bin/docker-compose
    ln -sf /usr/local/bin/docker-compose /usr/bin/docker-compose

    # vagrant 사용자를 docker 그룹에 추가
    usermod -aG docker vagrant

    # Docker 자동 시작 설정
    systemctl enable docker
    systemctl start docker

    # 유용한 도구 설치
    apt-get update
    apt-get install -y git curl wget vim

    echo "=========================================="
    echo "설치 완료!"
    echo "Docker 버전: $(docker --version)"
    echo "Docker Compose 버전: $(docker-compose --version)"
    echo "=========================================="
    echo ""
    echo "사용법:"
    echo "  vagrant ssh"
    echo "  docker ps"
    echo "  docker-compose up -d"
    echo "=========================================="
  SHELL

  # docker-compose.yml이 있으면 컨테이너 시작
  config.vm.provision "shell", run: "always", inline: <<-SHELL
    if [ -f /vagrant/docker-compose.yml ]; then
      echo "docker-compose.yml 발견! 컨테이너 시작 중..."
      cd /vagrant
      docker-compose up -d
    fi
  SHELL
end
